# Copy to backend/.env and fill in real values. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45

# Comma-separated browser origins allowed by CORS.
# Local dev + your deployed Vercel domain (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,https://your-nexum-app.vercel.app

# Optional overrides
# DATABASE_URL=sqlite:///./nexum.db
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=10485760
